# 复制成 .env.local 填真实值即可（.env.local 已在 .gitignore 中，不会提交）
# 生产环境在 Vercel → Project Settings → Environment Variables 中填写。
# 注意：NEXT_PUBLIC_ 开头的变量是构建时内联的，改完需要重新部署才生效。

# 生产域名，影响 canonical 链接与 OG 分享图地址
NEXT_PUBLIC_SITE_URL=

# 首页 Hero 视频 —— 放到对象存储后填这里，留空则用 public/ 下的本地文件
# 建议 webm / mp4 两个都传：Chrome、Edge、Firefox 会挑体积更小的 webm，Safari 用 mp4
NEXT_PUBLIC_HERO_VIDEO_WEBM=
NEXT_PUBLIC_HERO_VIDEO_MP4=
NEXT_PUBLIC_HERO_VIDEO_POSTER=

# 首页圆形头像（留空则用代码里的默认地址）
NEXT_PUBLIC_AVATAR_URL=

# 站点上线时间，首页底部「已运行」计时器的起点（留空则用代码里的默认值）
# 写成带时区偏移的本地时间最直观，例如 2026-10-05T00:00:00+08:00
NEXT_PUBLIC_SITE_LAUNCH_AT=
